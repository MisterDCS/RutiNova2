<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".RegistroNuevoHabito1">


    <LinearLayout
        android:layout_width="409dp"
        android:layout_height="729dp"
        android:orientation="vertical"
        tools:layout_editor_absoluteX="1dp"
        tools:layout_editor_absoluteY="1dp"
        tools:ignore="MissingConstraints">


        <ImageView
            android:id="@+id/titulo"
            android:layout_width="match_parent"
            android:layout_height="89dp"
            android:layout_marginBottom="16dp"
            android:scaleType="fitXY"
            android:src="@drawable/rutinovacentro" />

        <TextView
            android:id="@+id/lblRegistroHabito"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Registro de nuevo hábito"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:id="@+id/lblNombreHabito"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="Nombre del hábito"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/txtNombreHabito"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:hint="Ingresa el nombre del hábito"
            android:minHeight="48dp" />

        <TextView
            android:id="@+id/lblRecurrencia"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="Recurrencia"
            android:textSize="16sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="349dp"
            android:layout_marginBottom="16dp"
            android:orientation="vertical">

            <Switch
                android:id="@+id/switchLunes"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="Lunes"
                tools:ignore="UseSwitchCompatOrMaterialXml" />

            <Switch
                android:id="@+id/switchMartes"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="Martes"
                tools:ignore="UseSwitchCompatOrMaterialXml" />

            <Switch
                android:id="@+id/switchMiercoles"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="Miércoles"
                tools:ignore="UseSwitchCompatOrMaterialXml" />

            <Switch
                android:id="@+id/switchJueves"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="Jueves"
                tools:ignore="UseSwitchCompatOrMaterialXml" />

            <Switch
                android:id="@+id/switchViernes"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="Viernes"
                tools:ignore="UseSwitchCompatOrMaterialXml" />

            <Switch
                android:id="@+id/switchSabado"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="Sábado"
                tools:ignore="UseSwitchCompatOrMaterialXml" />

            <Switch
                android:id="@+id/switchDomingo"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="Domingo"
                tools:ignore="UseSwitchCompatOrMaterialXml" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="85dp"
            android:layout_marginBottom="16dp"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/boton_guardar"
                android:layout_width="171dp"
                android:layout_height="80dp"
                android:layout_marginEnd="16dp"
                android:contentDescription="Guardar"
                android:src="@drawable/botonguardar" />

            <ImageView
                android:id="@+id/boton_cancelar"
                android:layout_width="171dp"
                android:layout_height="80dp"
                android:contentDescription="Cancelar"
                android:src="@drawable/botoncancelar" />
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>